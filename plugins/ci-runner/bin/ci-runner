#!/usr/bin/env bash
# ci-runner — run a repository's GitHub Actions jobs on your own machine.
#
# Registers this machine as a self-hosted runner for one repository (or an
# organization), runs it as a service, and flips the repository variables that
# a select-runner workflow (`ci-runner workflow`) reads to choose between the
# self-hosted runner and a GitHub-hosted one. Generalised from ZenithML/zenith's
# self-hosted-runner/ scripts.
#
# The runner only makes outbound HTTPS calls (it long-polls GitHub for jobs),
# so no static IP, port forwarding or inbound firewall rule is needed.
#
# Portable on purpose: bash 3.2 (macOS /bin/bash), BSD and GNU userlands. No
# associative arrays, no mapfile, no `${var,,}`, no `sed -i`, no `readlink -f`,
# and no empty-array expansions under `set -u`.
set -euo pipefail

VERSION="0.2.0"

# ── locate our own files through any symlink (no readlink -f on macOS) ──────
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
PLUGIN_DIR="$(cd "$(dirname "$self")/.." && pwd)"
TEMPLATE="$PLUGIN_DIR/templates/select-runner.yml"

GH_HOST_NAME="${GH_HOST:-github.com}"
# Linux resource caps: every instance joins one slice, so the cap is shared by all of them.
SYSTEMD_DIR="${CI_RUNNER_SYSTEMD_DIR:-/etc/systemd/system}"
SLICE="ci-runner.slice"
DROPIN="ci-runner-slice.conf"

die() { echo "ci-runner: $*" >&2; exit 1; }
say() { echo "==> $*"; }

usage() {
  cat <<'EOF'
ci-runner: run a repository's GitHub Actions jobs on your own machine

Usage: ci-runner <command> [options]

Everyday:
  on          Turn it on: jobs go to your machine when it is online, else to GitHub-hosted
              runners (needs a token for that fallback; see below). --no-fallback: always your machine.
  off         Turn it off: the next run is back on GitHub-hosted runners.
  status      Is it on? Which mode? Is the runner online? What is missing?

One-time setup:
  install     Register this machine as a runner and start it as a service
  workflow    Write .github/workflows/select-runner.yml (commit it, then point jobs at it)
  uninstall   Stop, deregister and delete the runners installed for a repo or org
  version     Print the version

Options (on, off, status, install, uninstall):
  --repo OWNER/NAME   The repository (default: the current directory's, via gh)
  --org ORG           install/uninstall/status: register at organization level instead.
                      The runner then serves every repo the org's Default runner group allows.
  --dry-run           Print what would happen, change nothing

install:
  --create-user       Linux: run jobs as a dedicated account 'ci-runner', created if missing
                      (recommended). Without it you are asked; your own account also works.
  --run-as USER       Linux: use this account instead (--create-user creates it if missing)
  --yes               Do not ask: use your own account
  --count N           Runner instances on this machine; each runs one job at a time (default: 1)
  --label LABEL       Label jobs target (default: self-hosted). The runner also gets its OS and
                      architecture labels (Linux/macOS, X64/ARM64) automatically.
  --dir DIR           Where runners live (default: ~/actions-runner, in the job account's home)
  --runner-version V  actions/runner version (default: latest release)

on:
  --no-fallback       Always use your machine; jobs wait in the queue while it is off
  --label LABEL       Label to target (default: self-hosted)
  --org-runner        The runner is registered on the organization (ci-runner install --org)

workflow:
  --out PATH          Where to write it (default: .github/workflows/select-runner.yml)
  --force             Overwrite an existing file

The fallback needs a token that can list the repository's runners (GITHUB_TOKEN cannot),
stored as the RUNNER_STATUS_PAT secret. 'ci-runner on' asks for it (hidden input), or takes it
from the environment: RUNNER_STATUS_PAT=<token> ci-runner on. Press Enter to skip it in a
terminal (jobs then always target your machine); without a terminal, 'on' needs the token or
--no-fallback.

Environment:
  GH_HOST             GitHub Enterprise host (default: github.com)
EOF
}

need_gh() {
  command -v gh >/dev/null 2>&1 || die "the GitHub CLI (gh) is required: https://cli.github.com"
  gh auth status >/dev/null 2>&1 || die "gh is not signed in; run 'gh auth login' first"
}

# ── option parsing (shared by every command) ─────────────────────────────────
REPO=""
ORG=""
LABEL="self-hosted"
COUNT=1
DIR_BASE=""
RUN_AS=""
CREATE_USER=false
NO_FALLBACK=false
ORG_RUNNER=false
REPO_FROM_CWD=false
RUNNER_VERSION=""
ASSUME_YES=false
DRY_RUN=false
OUT=".github/workflows/select-runner.yml"
FORCE=false
CPU_CAP=""
MEM_CAP=""
LABEL_GIVEN=false
ALLOW_POS=false
POSITIONAL=""

# A cap is a whole percentage of the machine, 1-100, or 'none' to remove it.
valid_pct() {
  case "$2" in
    none|[1-9]|[1-9][0-9]|100) return 0 ;;
  esac
  die "$1 must be a whole percentage from 1 to 100, or 'none' (got '$2')"
}

parse_opts() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) [ $# -ge 2 ] || die "--repo needs OWNER/NAME"; REPO="$2"; shift 2 ;;
      --org) [ $# -ge 2 ] || die "--org needs a name"; ORG="$2"; shift 2 ;;
      --label) [ $# -ge 2 ] || die "--label needs a value"; LABEL="$2"; LABEL_GIVEN=true; shift 2 ;;
      --cpu) [ $# -ge 2 ] || die "--cpu needs a percentage or 'none'"; valid_pct --cpu "$2"; CPU_CAP="$2"; shift 2 ;;
      --memory) [ $# -ge 2 ] || die "--memory needs a percentage or 'none'"; valid_pct --memory "$2"; MEM_CAP="$2"; shift 2 ;;
      --count) [ $# -ge 2 ] || die "--count needs a number"; COUNT="$2"; shift 2 ;;
      --dir) [ $# -ge 2 ] || die "--dir needs a path"; DIR_BASE="$2"; shift 2 ;;
      --run-as) [ $# -ge 2 ] || die "--run-as needs a user"; RUN_AS="$2"
        case "$RUN_AS" in ''|-*|*[!A-Za-z0-9._-]*) die "invalid user name '$RUN_AS' for --run-as" ;; esac
        shift 2 ;;
      --create-user) CREATE_USER=true; shift ;;
      --no-fallback) NO_FALLBACK=true; shift ;;
      --org-runner) ORG_RUNNER=true; shift ;;
      --runner-version) [ $# -ge 2 ] || die "--runner-version needs a version"; RUNNER_VERSION="${2#v}"; shift 2 ;;
      --out) [ $# -ge 2 ] || die "--out needs a path"; OUT="$2"; shift 2 ;;
      --yes|-y) ASSUME_YES=true; shift ;;
      --dry-run|-n) DRY_RUN=true; shift ;;
      --force|-f) FORCE=true; shift ;;
      --help|-h) usage; exit 0 ;;
      -*) die "unknown option '$1' (see ci-runner --help)" ;;
      *)
        if $ALLOW_POS && [ -z "$POSITIONAL" ]; then POSITIONAL="$1"; shift
        else die "unexpected argument '$1' (see ci-runner --help)"
        fi ;;
    esac
  done
  case "$COUNT" in ''|*[!0-9]*|0) die "--count must be a positive integer (got '$COUNT')" ;; esac
  case "$LABEL" in ''|*[!A-Za-z0-9._-]*) die "--label may only use letters, digits, '.', '_' and '-' (got '$LABEL')" ;; esac
  if [ -n "$REPO" ] && [ -n "$ORG" ]; then die "use --repo or --org, not both"; fi
  case "$REPO" in ''|*/*) ;; *) die "--repo must be OWNER/NAME (got '$REPO')" ;; esac
  return 0
}

# Fill REPO from the current directory when neither --repo nor --org was given.
resolve_repo() {
  if [ -z "$REPO" ] && [ -z "$ORG" ]; then
    REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)" \
      || die "not inside a GitHub repository; pass --repo OWNER/NAME"
    REPO_FROM_CWD=true
  fi
}

# Repo variables are per repository even when the runner is org-level.
require_repo() {
  [ -z "$ORG" ] || die "this command works on one repository's variables; pass --repo OWNER/NAME"
  resolve_repo
}

# API path, registration URL and directory slug for the target.
api_scope() { if [ -n "$ORG" ]; then echo "orgs/$ORG"; else echo "repos/$REPO"; fi; }
target_url() { if [ -n "$ORG" ]; then echo "https://$GH_HOST_NAME/$ORG"; else echo "https://$GH_HOST_NAME/$REPO"; fi; }
target_slug() { if [ -n "$ORG" ]; then echo "${ORG}-org"; else echo "${REPO#*/}"; fi; }

home_of() {
  local user="$1" h=""
  if command -v getent >/dev/null 2>&1; then h="$(getent passwd "$user" | cut -d: -f6)"; fi
  [ -n "$h" ] || h="$(eval echo "~$user")"
  case "$h" in
    "~"*|"")
      # A dry run may name an account it would create; guess where its home will be.
      if $DRY_RUN && $CREATE_USER; then echo "/home/$user"; return 0; fi
      die "user '$user' does not exist" ;;
  esac
  echo "$h"
}

default_dir_base() {
  if [ -n "$DIR_BASE" ]; then echo "$DIR_BASE"
  elif [ -n "$RUN_AS" ]; then echo "$(home_of "$RUN_AS")/actions-runner"
  else echo "$HOME/actions-runner"
  fi
}

# Instance 1 keeps the bare slug (zenith's original layout), later ones get -N.
instance_dir() { if [ "$2" -eq 1 ]; then echo "$1/$(target_slug)"; else echo "$1/$(target_slug)-$2"; fi; }
instance_name() {
  local host; host="$(hostname -s 2>/dev/null || hostname)"
  if [ "$1" -eq 1 ]; then echo "$host-$(target_slug)"; else echo "$host-$(target_slug)-$1"; fi
}

# Every instance directory for the target: the bare slug, then slug-2, slug-3...
# (a numeric suffix only, so repo "agent" never matches "agent-anywhere").
instance_dirs() {
  local base="$1" dir
  [ -d "$base/$(target_slug)" ] && echo "$base/$(target_slug)"
  for dir in "$base/$(target_slug)"-*; do
    [ -d "$dir" ] || continue
    case "${dir##*-}" in ''|*[!0-9]*) continue ;; esac
    echo "$dir"
  done
  return 0
}

# Run a command as the runner's account: plain when that is us, sudo -u otherwise.
as_runner() {
  if [ -n "$RUN_AS" ] && [ "$RUN_AS" != "$(id -un)" ]; then sudo -u "$RUN_AS" -H "$@"; else "$@"; fi
}

run() {
  if $DRY_RUN; then echo "   [dry-run] $*"; else "$@"; fi
}

# Root for system files: directly when we are root, else through sudo.
as_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }

# Write a root-owned file; a dry run prints the content instead.
write_root_file() {
  if $DRY_RUN; then
    echo "   [dry-run] write $1:"
    printf '%s\n' "$2" | sed 's/^/      | /'
  else
    printf '%s\n' "$2" | as_root tee "$1" >/dev/null
  fi
}

# ── resource caps (Linux, systemd) ───────────────────────────────────────────
is_macos() { [ "$(uname -s)" = Darwin ]; }
caps_given() { [ -n "$CPU_CAP" ] || [ -n "$MEM_CAP" ]; }
macos_caps_notice() {
  echo "Note: resource caps (--cpu, --memory, limits) are not supported on macOS; carrying on without them."
}

cpu_cores() {
  local n
  n="$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || true)"
  case "$n" in ''|*[!0-9]*|0) n=1 ;; esac
  echo "$n"
}

# The percentages the user chose live on the slice's '# ci-runner:' comment line.
read_caps() {
  local line kv
  CUR_CPU=none; CUR_MEM=none
  [ -f "$SYSTEMD_DIR/$SLICE" ] || return 0
  line="$(sed -n 's/^# ci-runner: //p' "$SYSTEMD_DIR/$SLICE" | head -1)"
  for kv in $line; do
    case "$kv" in
      cpu=*) CUR_CPU="${kv#cpu=}" ;;
      memory=*) CUR_MEM="${kv#memory=}" ;;
    esac
  done
  case "$CUR_CPU" in none|[1-9]|[1-9][0-9]|100) ;; *) CUR_CPU=none ;; esac
  case "$CUR_MEM" in none|[1-9]|[1-9][0-9]|100) ;; *) CUR_MEM=none ;; esac
}

# What this run leaves in place: the flags given, else what is already set.
effective_caps() {
  read_caps
  EFF_CPU="${CPU_CAP:-$CUR_CPU}"
  EFF_MEM="${MEM_CAP:-$CUR_MEM}"
}

caps_summary() {
  local cores text
  if is_macos; then echo "not supported on macOS"; return 0; fi
  effective_caps
  if [ "$EFF_CPU" = none ] && [ "$EFF_MEM" = none ]; then echo "none"; return 0; fi
  cores="$(cpu_cores)"
  if [ "$EFF_CPU" = none ]; then text="CPU uncapped"
  else text="CPU $EFF_CPU% ($(awk -v p="$EFF_CPU" -v c="$cores" 'BEGIN { printf "%g", p * c / 100 }') of $cores cores)"
  fi
  if [ "$EFF_MEM" = none ]; then text="$text, memory uncapped"; else text="$text, memory $EFF_MEM%"; fi
  echo "$text"
}

slice_content() {
  local cores
  cores="$(cpu_cores)"
  echo "# Written by ci-runner (agent-framework, plugins/ci-runner). Change with: ci-runner limits"
  echo "# ci-runner: cpu=$1 memory=$2"
  echo "[Unit]"
  echo "Description=ci-runner: self-hosted GitHub Actions runners (shared resource cap)"
  echo
  echo "[Slice]"
  echo "CPUAccounting=yes"
  echo "MemoryAccounting=yes"
  if [ "$1" != none ]; then echo "CPUQuota=$(($1 * cores))%"; fi
  if [ "$2" != none ]; then echo "MemoryMax=$2%"; fi
}

# Write the slice with the effective caps and apply them to the running slice too.
apply_caps() {
  local cores cpuprop memprop
  effective_caps
  cores="$(cpu_cores)"
  say "Resource caps for all ci-runner instances on this machine: $(caps_summary)"
  write_root_file "$SYSTEMD_DIR/$SLICE" "$(slice_content "$EFF_CPU" "$EFF_MEM")"
  run as_root systemctl daemon-reload
  if [ "$EFF_CPU" = none ]; then cpuprop="CPUQuota="; else cpuprop="CPUQuota=$((EFF_CPU * cores))%"; fi
  if [ "$EFF_MEM" = none ]; then memprop="MemoryMax=infinity"; else memprop="MemoryMax=$EFF_MEM%"; fi
  run as_root systemctl set-property --runtime "$SLICE" "$cpuprop" "$memprop" \
    || echo "   warning: could not apply the caps to the running slice; they apply when its runners next start" >&2
}

# An uncapped slice, so instances can join it now and 'limits' later needs no restart.
ensure_slice() {
  [ -f "$SYSTEMD_DIR/$SLICE" ] && return 0
  write_root_file "$SYSTEMD_DIR/$SLICE" "$(slice_content none none)"
  run as_root systemctl daemon-reload
}

platform() {
  local os arch
  os="$(uname -s)"; arch="$(uname -m)"
  case "$os" in
    Linux) os=linux ;;
    Darwin) os=osx ;;
    *) die "unsupported OS '$os' (Linux and macOS only; for Windows follow $(target_url)/settings/actions/runners/new)" ;;
  esac
  case "$arch" in
    x86_64|amd64) arch=x64 ;;
    aarch64|arm64) arch=arm64 ;;
    *) die "unsupported architecture '$arch'" ;;
  esac
  echo "$os-$arch"
}

sha256_of() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else echo ""
  fi
}

# The actions/runner release notes carry each package's SHA-256 between
# <!-- BEGIN SHA <platform> --> and <!-- END SHA <platform> --> markers.
expected_sha() {
  local version="$1" plat="$2" body
  body="$(gh api "repos/actions/runner/releases/tags/v$version" --jq .body 2>/dev/null)" || return 0
  printf '%s\n' "$body" | sed -n "s/.*<!-- BEGIN SHA $plat -->\([0-9a-f]\{64\}\)<!-- END SHA $plat -->.*/\1/p" | head -1
}

# Linux: make sure the job account exists, creating it when asked to.
ensure_runner_user() {
  id "$RUN_AS" >/dev/null 2>&1 && return 0
  $CREATE_USER || die "user '$RUN_AS' does not exist. Add --create-user to create it, or: sudo useradd --create-home --shell /bin/bash $RUN_AS"
  say "Creating the account '$RUN_AS' (sudo)"
  run sudo useradd --create-home --shell /bin/bash "$RUN_AS"
}

# Decide which account runs the jobs, and say plainly when it is your own.
confirm_account() {
  local plat="$1" answer
  if $CREATE_USER && [ -z "$RUN_AS" ]; then RUN_AS="ci-runner"; fi
  if [ "$(id -u)" -eq 0 ] && { [ -z "$RUN_AS" ] || [ "$RUN_AS" = root ]; }; then
    die "do not run CI jobs as root; add --create-user (or --run-as USER) for a dedicated account, or run ci-runner as that user"
  fi
  case "$plat" in
    osx-*)
      [ -z "$RUN_AS" ] || die "--run-as and --create-user are Linux only. On macOS, sign in as the dedicated user (su - USER) and run ci-runner there."
      ;;
    *)
      if [ -n "$RUN_AS" ]; then ensure_runner_user; return 0; fi
      ;;
  esac
  cat >&2 <<EOF

  Heads-up: the runner would run CI jobs as '$(id -un)', your current account.
  Every job can read whatever this account can (SSH keys, .env files, other
  checkouts, gh and cloud credentials), and tests that start tmux sessions,
  install services or put mock CLIs on PATH run alongside your own work.
  A dedicated account avoids that:
    Linux:  ci-runner install --create-user ...    (creates 'ci-runner')
    macOS:  create a standard user, sign in as it, and run ci-runner there.
  Your own account is fine for a private repo on a machine you trust.

EOF
  $ASSUME_YES && return 0
  $DRY_RUN && return 0
  [ -t 0 ] || die "not a terminal: pass --yes to use your own account, or --create-user / --run-as USER"
  case "$plat" in
    linux-*)
      printf "Create a dedicated 'ci-runner' account and use it (recommended)? [Y/n] " >&2
      read -r answer
      case "$answer" in
        ''|y|Y|yes|YES) RUN_AS="ci-runner"; CREATE_USER=true; ensure_runner_user; return 0 ;;
      esac
      ;;
  esac
  printf 'Install under %s then? [y/N] ' "$(id -un)" >&2
  read -r answer
  case "$answer" in y|Y|yes|YES) ;; *) die "cancelled" ;; esac
}

install_one() {
  local i="$1" base="$2" plat="$3" version="$4" dir name tarball url sha want token
  dir="$(instance_dir "$base" "$i")"
  name="$(instance_name "$i")"
  if [ -x "$dir/config.sh" ] && [ -f "$dir/.runner" ]; then
    say "[$i/$COUNT] $name already installed at $dir, leaving it alone"
    return 0
  fi

  tarball="actions-runner-$plat-$version.tar.gz"
  url="https://github.com/actions/runner/releases/download/v$version/$tarball"
  say "[$i/$COUNT] Downloading $tarball into $dir"
  if [ -n "$RUN_AS" ] && [ "$RUN_AS" != "$(id -un)" ]; then
    run sudo mkdir -p "$dir"
    run sudo chown "$RUN_AS" "$dir"
  else
    run mkdir -p "$dir"
  fi
  run as_runner curl -fsSL -o "$dir/$tarball" "$url"
  if ! $DRY_RUN; then
    want="$(expected_sha "$version" "$plat")"
    sha="$(sha256_of "$dir/$tarball")"
    if [ -n "$want" ] && [ -n "$sha" ]; then
      [ "$want" = "$sha" ] || { as_runner rm -f "$dir/$tarball"; die "checksum mismatch for $tarball (expected $want, got $sha)"; }
      say "[$i/$COUNT] Checksum verified"
    else
      echo "   warning: could not verify the download's SHA-256 (no checksum in the release notes or no shasum tool)" >&2
    fi
  fi
  run as_runner tar xzf "$dir/$tarball" -C "$dir"
  run as_runner rm -f "$dir/$tarball"

  say "[$i/$COUNT] Registering $name with $(target_url) (label: $LABEL)"
  if $DRY_RUN; then
    token="<registration-token>"
  else
    token="$(gh api -X POST "$(api_scope)/actions/runners/registration-token" --jq .token)" \
      || die "could not get a registration token for $(api_scope); you need admin rights on it"
  fi
  # shellcheck disable=SC2016  # the subshell expands these, not this shell
  run as_runner sh -c 'cd "$1" && ./config.sh --unattended --url "$2" --token "$3" --name "$4" --labels "$5" --work _work --replace' \
    sh "$dir" "$(target_url)" "$token" "$name" "$LABEL"

  case "$plat" in
    linux-*)
      say "[$i/$COUNT] Installing the systemd service (sudo)"
      run sh -c 'cd "$1" && sudo ./svc.sh install "$2" && sudo ./svc.sh start' sh "$dir" "${RUN_AS:-$(id -un)}"
      ;;
    osx-*)
      say "[$i/$COUNT] Installing the launchd agent (runs while $(id -un) is signed in)"
      run sh -c 'cd "$1" && ./svc.sh install && ./svc.sh start' sh "$dir"
      ;;
  esac
}

cmd_install() {
  need_gh
  resolve_repo
  local plat base version i
  plat="$(platform)"
  confirm_account "$plat"
  base="$(default_dir_base)"
  version="$RUNNER_VERSION"
  if [ -z "$version" ]; then
    version="$(gh api repos/actions/runner/releases/latest --jq .tag_name)" || die "could not look up the latest actions/runner release"
    version="${version#v}"
  fi
  say "Installing $COUNT runner(s) for $(target_url), actions/runner $version ($plat), under $base"
  i=1
  while [ "$i" -le "$COUNT" ]; do
    install_one "$i" "$base" "$plat" "$version"
    i=$((i + 1))
  done

  echo
  if $DRY_RUN; then echo "Dry run: nothing was changed."; return 0; fi
  echo "Installed. Jobs still run on GitHub-hosted runners until you turn it on:"
  if [ -n "$ORG" ]; then
    echo "  ci-runner workflow                                   (once per repo; commit the file)"
    echo "  ci-runner on --org-runner --repo $ORG/<repo>          (per repo that should use it)"
  else
    echo "  ci-runner workflow         (once: writes .github/workflows/select-runner.yml; commit it and point jobs at it)"
    echo "  ci-runner on --repo $REPO"
  fi
  echo "Jobs should not count on passwordless sudo: preinstall what they would apt-get or brew install."
}

cmd_uninstall() {
  need_gh
  resolve_repo
  local base dir found=false token user run_as_given="$RUN_AS"
  base="$(default_dir_base)"
  for dir in $(instance_dirs "$base"); do
    [ -x "$dir/config.sh" ] || continue
    RUN_AS="$run_as_given"  # decided per directory below, never carried over from the last one
    found=true
    say "Removing the runner at $dir"
    if [ -x "$dir/svc.sh" ]; then
      case "$(platform)" in
        linux-*) run sh -c 'cd "$1" && { sudo ./svc.sh stop; sudo ./svc.sh uninstall; } || true' sh "$dir" ;;
        osx-*) run sh -c 'cd "$1" && { ./svc.sh stop; ./svc.sh uninstall; } || true' sh "$dir" ;;
      esac
    fi
    if $DRY_RUN; then
      token="<remove-token>"
    else
      token="$(gh api -X POST "$(api_scope)/actions/runners/remove-token" --jq .token)" \
        || die "could not get a removal token for $(api_scope)"
    fi
    # The runner's own files belong to its account; remove as that account.
    # shellcheck disable=SC2012  # stat's flags differ between BSD and GNU; ls -ld does not
    user="$(ls -ld "$dir" | awk '{print $3}')"
    if [ "$user" != "$(id -un)" ]; then RUN_AS="$user"; fi
    # shellcheck disable=SC2016
    run as_runner sh -c 'cd "$1" && ./config.sh remove --token "$2"' sh "$dir" "$token"
    if [ -n "$RUN_AS" ] && [ "$RUN_AS" != "$(id -un)" ]; then run sudo rm -rf "$dir"; else run rm -rf "$dir"; fi
  done
  if ! $found; then
    echo "No runners for $(target_slug) under $base; nothing to remove."
    return 0
  fi
  if [ -z "$ORG" ]; then
    echo "Done. If $REPO still points at this runner, run: ci-runner off --repo $REPO"
  fi
}

# Delete a repository variable; fine if it was never set.
delete_var() {
  if $DRY_RUN; then echo "   [dry-run] gh variable delete $1 --repo $REPO"; return 0; fi
  gh variable delete "$1" --repo "$REPO" >/dev/null 2>&1 || true
}

# 0: the secret exists, 1: it does not, 2: could not tell (listing secrets needs admin rights).
has_status_token() {
  local list
  list="$(gh secret list --repo "$REPO" 2>/dev/null)" || return 2
  printf '%s\n' "$list" | grep -q '^RUNNER_STATUS_PAT[[:space:]]'
}

cmd_status() {
  need_gh
  resolve_repo
  local base dir found=false auto label scope online listing rc
  if [ -z "$ORG" ]; then
    auto="$(gh variable get CI_RUNNER_AUTO --repo "$REPO" 2>/dev/null || true)"
    label="$(gh variable get CI_RUNNER_LABEL --repo "$REPO" 2>/dev/null || true)"
    scope="$(gh variable get CI_RUNNER_SCOPE --repo "$REPO" 2>/dev/null || true)"
    echo "$REPO"
    if [ "$auto" = true ]; then
      echo "  Switch:  ON, with fallback (your '${label:-self-hosted}' runner when online, else GitHub-hosted)"
      has_status_token && rc=0 || rc=$?
      [ "$rc" -ne 1 ] || echo "  Problem: the RUNNER_STATUS_PAT secret is missing, so every run uses GitHub-hosted. Fix: ci-runner on"
    elif [ -n "$label" ]; then
      echo "  Switch:  ON, always '$label' (jobs wait in the queue while no runner is online)"
    else
      echo "  Switch:  OFF (jobs run on GitHub-hosted runners)"
    fi
    if $REPO_FROM_CWD; then
      if [ -f .github/workflows/select-runner.yml ]; then
        echo "  This checkout: select-runner.yml present (jobs must also use its output; see the README)"
      else
        echo "  This checkout: .github/workflows/select-runner.yml missing. Fix: ci-runner workflow"
      fi
    fi
  fi
  if [ "${scope:-}" = org ] && [ -z "$ORG" ]; then
    listing="orgs/${REPO%%/*}/actions/runners"
  else
    listing="$(api_scope)/actions/runners"
  fi
  echo "Runners on ${listing%/actions/runners}:" | sed 's|on repos/|on |; s|on orgs/|on org |'
  if online="$(gh api "$listing?per_page=100" --jq '[.runners[] | select(.status == "online")] | length' 2>/dev/null)"; then
    gh api "$listing?per_page=100" \
      --jq '.runners[] | "  \(.name)\t\(.status)\(if .busy then " (busy)" else "" end)\t\([.labels[].name] | join(","))"' 2>/dev/null || true
    [ "$online" -gt 0 ] || echo "  (none online: is the service running? On Linux: systemctl status 'actions.runner.*')"
  else
    echo "  (could not list them; that needs admin rights on ${listing%/actions/runners})"
  fi
  base="$(default_dir_base)"
  echo "Runner directories on this machine, under $base:"
  for dir in $(instance_dirs "$base"); do
    found=true
    echo "  $dir"
  done
  $found || echo "  (none)"
}

# The fallback needs a token that can list runners (GITHUB_TOKEN cannot). Store it as the
# RUNNER_STATUS_PAT secret when handed over (environment, or a hidden prompt). Returns 0 when
# stored, 1 when there is none; either way the caller carries on.
store_status_token() {
  local perm tok="${RUNNER_STATUS_PAT:-}"
  if $ORG_RUNNER; then
    perm='Organization permission "Self-hosted runners: Read-only"'
  else
    perm='Repository permission "Administration: Read-only"'
  fi
  if [ -z "$tok" ] && [ -t 0 ] && ! $DRY_RUN; then
    cat >&2 <<EOF

  The fallback to GitHub-hosted runners needs a token that can list this repository's
  runners. Create a fine-grained token at https://$GH_HOST_NAME/settings/personal-access-tokens/new
    Repository access: only $REPO
    $perm
  and paste it here. It is stored as the RUNNER_STATUS_PAT secret and never shown.
EOF
    printf 'Token (hidden), or Enter to skip: ' >&2
    read -rs tok || true
    echo >&2
  fi
  if [ -n "$tok" ]; then
    if $DRY_RUN; then
      echo "   [dry-run] store the token as the RUNNER_STATUS_PAT secret on $REPO"
    else
      printf '%s' "$tok" | gh secret set RUNNER_STATUS_PAT --repo "$REPO" >/dev/null \
        || die "could not store the RUNNER_STATUS_PAT secret on $REPO"
      echo "Stored the RUNNER_STATUS_PAT secret on $REPO."
    fi
    return 0
  fi
  # Not a terminal and no token: do not quietly turn the fallback off.
  if [ ! -t 0 ] && ! $DRY_RUN; then
    die "no token for the fallback. Pass RUNNER_STATUS_PAT=<token>, or --no-fallback to always use your machine"
  fi
  cat <<EOF

  No token for the fallback, so jobs will always target your machine. To add the fallback:
  create a fine-grained token at https://$GH_HOST_NAME/settings/personal-access-tokens/new
  (only $REPO; $perm), then run:
    RUNNER_STATUS_PAT=<token> ci-runner on --repo $REPO
EOF
  return 1
}

cmd_on() {
  need_gh
  require_repo
  local fallback=true
  $NO_FALLBACK && fallback=false
  if $fallback; then
    local have=0
    has_status_token && have=0 || have=$?
    if [ "$have" -eq 2 ]; then
      # Cannot list secrets: do not guess. Store a token only when one was handed over.
      if [ -n "${RUNNER_STATUS_PAT:-}" ]; then store_status_token || true
      else echo "Could not check for the RUNNER_STATUS_PAT secret (needs admin rights); assuming it is set." >&2
      fi
    elif [ "$have" -eq 1 ]; then
      store_status_token || fallback=false
    fi
  fi
  if $ORG_RUNNER; then
    run gh variable set CI_RUNNER_SCOPE --repo "$REPO" --body org
  else
    delete_var CI_RUNNER_SCOPE
  fi
  if $fallback; then
    run gh variable set CI_RUNNER_AUTO --repo "$REPO" --body true
    if [ "$LABEL" = "self-hosted" ]; then
      delete_var CI_RUNNER_LABEL
    else
      run gh variable set CI_RUNNER_LABEL --repo "$REPO" --body "$LABEL"
    fi
    echo "On, with fallback: jobs in $REPO use your '$LABEL' runner when it is online, else GitHub-hosted."
  else
    run gh variable set CI_RUNNER_LABEL --repo "$REPO" --body "$LABEL"
    delete_var CI_RUNNER_AUTO
    echo "On, always '$LABEL': jobs in $REPO wait in the queue while no such runner is online."
  fi
  echo "Check with: ci-runner status --repo $REPO     Turn off: ci-runner off --repo $REPO"
}

cmd_off() {
  need_gh
  require_repo
  local name
  for name in CI_RUNNER_LABEL CI_RUNNER_AUTO CI_RUNNER_SCOPE; do delete_var "$name"; done
  echo "Off: jobs in $REPO run on GitHub-hosted runners again, from the next run."
  echo "The runner service keeps idling (harmless); 'ci-runner uninstall --repo $REPO' removes it."
}

cmd_limits() {
  if is_macos; then macos_caps_notice; return 0; fi
  if ! caps_given; then
    echo "Resource caps (all ci-runner instances on this machine): $(caps_summary)"
    if [ -f "$SYSTEMD_DIR/$SLICE" ]; then echo "  Set in $SYSTEMD_DIR/$SLICE"; fi
    echo "Change: ci-runner limits --cpu PCT --memory PCT   (percent of the machine; 'none' removes one)"
    return 0
  fi
  apply_caps
  if $DRY_RUN; then echo; echo "Dry run: nothing was changed."; fi
}

cmd_workflow() {
  [ -f "$TEMPLATE" ] || die "template not found at $TEMPLATE"
  if [ -e "$OUT" ] && ! $FORCE; then
    if cmp -s "$TEMPLATE" "$OUT"; then echo "$OUT is already up to date."; return 0; fi
    die "$OUT exists and differs; pass --force to overwrite"
  fi
  run mkdir -p "$(dirname "$OUT")"
  run cp "$TEMPLATE" "$OUT"
  cat <<EOF
Wrote $OUT. In each workflow, add a first job and point runs-on at its output:

  jobs:
    select-runner:
      uses: ./.github/workflows/select-runner.yml
      secrets: inherit
    build:
      needs: select-runner
      runs-on: \${{ needs.select-runner.outputs.target }}

Jobs that can land on the self-hosted runner should skip actions/cache-backed
caching there (the runner's disk persists between jobs anyway), e.g.
  if: needs.select-runner.outputs.self-hosted != 'true'
and must not rely on passwordless sudo.
EOF
}

[ $# -gt 0 ] || { usage; exit 1; }
command="$1"; shift
case "$command" in
  install) parse_opts "$@"; cmd_install ;;
  uninstall) parse_opts "$@"; cmd_uninstall ;;
  status) parse_opts "$@"; cmd_status ;;
  on|auto) parse_opts "$@"; cmd_on ;;
  off) parse_opts "$@"; cmd_off ;;
  workflow) parse_opts "$@"; cmd_workflow ;;
  limits) parse_opts "$@"; cmd_limits ;;
  version|--version|-V) echo "ci-runner $VERSION" ;;
  help|--help|-h) usage ;;
  *) echo "ci-runner: unknown command '$command'" >&2; usage >&2; exit 1 ;;
esac
