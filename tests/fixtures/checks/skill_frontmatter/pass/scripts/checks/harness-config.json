{
  "layout": {
    "skill_globs": [
      ".claude/skills/**/SKILL.md"
    ],
    "agent_globs": [
      ".claude/agents/*.md"
    ]
  },
  "minimum_frontmatter": [
    "name",
    "description"
  ],
  "strict_frontmatter": [
    "name",
    "description",
    "version",
    "owner",
    "updated",
    "source",
    "changelog"
  ],
  "manifest_required": true,
  "name_pattern": "^example-[a-z0-9-]+$",
  "strict_skills": [
    "example-good-skill",
    "example-wrapped-skill"
  ],
  "evals_required": [
    "example-good-skill",
    "example-wrapped-skill"
  ]
}
